{
  "manifest_version": 3,
  "name": "Доверительный интервал конверсии",
  "version": "1.0.0",
  "description": "Считает доверительный интервал конверсии на лету и сравнивает две выборки: графики распределений и простой ответ — отличаются или нет.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Доверительный интервал конверсии",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
